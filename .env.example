# Use only the NEW Good Chapter Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely for owner-authorised team invitations.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Fictional, in-memory local development only. Ignored in production.
CRM_DEMO_MODE=false

# Resend API for staff-triggered quotation/invoice emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Good Chapter <studio@thegoodchapter.in>
RESEND_REPLY_TO=YOUR_REPLY_EMAIL
# Optional full-access key for reading per-message status if the send key is send-only.
RESEND_TRACKING_API_KEY=
# Optional: Resend webhook signing secret for live delivered/opened/bounced events.
RESEND_WEBHOOK_SECRET=
# Optional: receiving API key if forwarded mail is delivered to a Resend address.
RESEND_INBOUND_API_KEY=

# Server-only AES-256-GCM key for social app secrets and OAuth tokens.
# Generate once with: openssl rand -base64 32
# Keep the same value in local development and the Vercel Production environment.
SOCIAL_TOKEN_KEY=
